server {
    listen 443 ssl;
    server_name accounts.example.org;
    ssl_certificate     /etc/letsencrypt/live/accounts.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/accounts.example.org/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:7380;
        proxy_set_header X-Forwarded-For $remote_addr;   # with TRUST_PROXY=1
        proxy_set_header Host $host;
    }
}
