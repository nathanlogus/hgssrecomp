# /etc/systemd/system/johto-accounts.service  (see SERVER.md)
[Unit]
Description=Johto Online account server
After=network.target

[Service]
User=johto
WorkingDirectory=/opt/johto-online
EnvironmentFile=/etc/johto-online/accounts.env
ExecStart=/usr/bin/python3 server/account_server.py serve
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=johto-accounts
# ACCOUNT_DB=/var/lib/johto-accounts/accounts.db in accounts.env

[Install]
WantedBy=multi-user.target
